 298:shy_fft.h     **** // Direct transform
 299:shy_fft.h     **** template <typename T, size_t num_passes, typename Phasor>
 300:shy_fft.h     **** struct DirectTransform
 301:shy_fft.h     **** {
 302:shy_fft.h     ****   private:
 303:shy_fft.h     ****     enum
 304:shy_fft.h     ****     {
