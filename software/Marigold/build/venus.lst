  49:../../../../Dependencies/libDaisy/src/per/dac.h ****         DMA,
  50:../../../../Dependencies/libDaisy/src/per/dac.h ****     };
  51:../../../../Dependencies/libDaisy/src/per/dac.h **** 
  52:../../../../Dependencies/libDaisy/src/per/dac.h ****     /** Sets the number of bits per sample transmitted out of the DAC.
  53:../../../../Dependencies/libDaisy/src/per/dac.h ****      ** The output range will be: 0V - VDDA
  54:../../../../Dependencies/libDaisy/src/per/dac.h ****      ** The resolution will be roughly: bitdepth / (VDDA - 0V) 
  55:../../../../Dependencies/libDaisy/src/per/dac.h ****      ***/
  56:../../../../Dependencies/libDaisy/src/per/dac.h ****     enum class BitDepth
  57:../../../../Dependencies/libDaisy/src/per/dac.h ****     {
  58:../../../../Dependencies/libDaisy/src/per/dac.h ****         BITS_8,
