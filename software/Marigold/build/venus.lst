  13:../../../../Dependencies/libDaisy/src/dev/leddriver.h **** /** LED driver for one or multiple PCA9685 12bit PWM chips connected to
  14:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  * a single I2C peripheral.
  15:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  * It includes gamma correction from 8bit brightness values but it 
  16:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  * can also be supplied with raw 12bit values.
  17:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  * This driver uses two buffers - one for drawing, one for transmitting.
  18:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  * Multiple LedDriverPca9685 instances can be used at the same time.
  19:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  * \param numDrivers    The number of PCA9685 driver attached to the I2C
  20:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  *                      peripheral.
  21:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  * \param persistentBufferContents If set to true, the current draw buffer 
  22:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  *                      contents will be copied to the next draw buffer 
  23:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  *                      during SwapBuffersAndTransmit(). Use this, if you plan
  24:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  *                      to write single leds at a time. 
  25:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  *                      If you will alway update all leds before calling 
  26:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  *                      SwapBuffersAndTransmit(), you can set this to false
  27:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  *                      and safe some cycles.
  28:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  * 
  29:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  *  @ingroup device
  30:../../../../Dependencies/libDaisy/src/dev/leddriver.h ****  */
  31:../../../../Dependencies/libDaisy/src/dev/leddriver.h **** template <int numDrivers, bool persistentBufferContents = true>
  32:../../../../Dependencies/libDaisy/src/dev/leddriver.h **** class LedDriverPca9685
