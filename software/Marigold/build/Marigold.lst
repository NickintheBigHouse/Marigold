  72:../../../../Dependencies/libDaisy/src/per/sai.h ****         };
  73:../../../../Dependencies/libDaisy/src/per/sai.h **** 
  74:../../../../Dependencies/libDaisy/src/per/sai.h ****         /** Specifies whether a particular block is the master or the slave 
  75:../../../../Dependencies/libDaisy/src/per/sai.h ****          ** If both are set to slave, no MCLK signal will be used, and it is
  76:../../../../Dependencies/libDaisy/src/per/sai.h ****          ** expected that the codec will have its own xtal.
