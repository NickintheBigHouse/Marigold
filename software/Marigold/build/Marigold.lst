  25:../../../../Dependencies/libDaisy/src/per/dac.h ****     enum class Result
  26:../../../../Dependencies/libDaisy/src/per/dac.h ****     {
  27:../../../../Dependencies/libDaisy/src/per/dac.h ****         OK,
  28:../../../../Dependencies/libDaisy/src/per/dac.h ****         ERR,
  29:../../../../Dependencies/libDaisy/src/per/dac.h ****     };
  30:../../../../Dependencies/libDaisy/src/per/dac.h **** 
  31:../../../../Dependencies/libDaisy/src/per/dac.h ****     /** Selects which channel(s) will be configured for use. */
  32:../../../../Dependencies/libDaisy/src/per/dac.h ****     enum class Channel
  33:../../../../Dependencies/libDaisy/src/per/dac.h ****     {
  34:../../../../Dependencies/libDaisy/src/per/dac.h ****         ONE,
  35:../../../../Dependencies/libDaisy/src/per/dac.h ****         TWO,
  36:../../../../Dependencies/libDaisy/src/per/dac.h ****         BOTH,
  37:../../../../Dependencies/libDaisy/src/per/dac.h ****     };
  38:../../../../Dependencies/libDaisy/src/per/dac.h **** 
  39:../../../../Dependencies/libDaisy/src/per/dac.h ****     /** Sets the Mode for the DAC channels.
  40:../../../../Dependencies/libDaisy/src/per/dac.h ****      **
  41:../../../../Dependencies/libDaisy/src/per/dac.h ****      ** Polling mode uses the blocking mode to transmit a single value at a time.
  42:../../../../Dependencies/libDaisy/src/per/dac.h ****      **
  43:../../../../Dependencies/libDaisy/src/per/dac.h ****      ** DMA mode uses a buffer, and periodically transmits it triggering a 
  44:../../../../Dependencies/libDaisy/src/per/dac.h ****      ** callback to fill the buffer when it is ready for more samples.
  45:../../../../Dependencies/libDaisy/src/per/dac.h ****      ***/
  46:../../../../Dependencies/libDaisy/src/per/dac.h ****     enum class Mode
  47:../../../../Dependencies/libDaisy/src/per/dac.h ****     {
  48:../../../../Dependencies/libDaisy/src/per/dac.h ****         POLLING,
