  49:shy_fft.h     ****         value = Log2<x / 2>::value + 1
  50:shy_fft.h     ****     };
  51:shy_fft.h     ****     typedef char CheckPowerOf2[((x & (x - 1)) == 0 ? 1 : -1)];
  52:shy_fft.h     **** };
