 192:Marigold.cpp  ****             detune_mode       = 2;
 193:Marigold.cpp  ****             detune_multiplier = 1;
 194:Marigold.cpp  ****         } else {
 195:Marigold.cpp  ****             detune_mode       = 0;
 196:Marigold.cpp  ****             detune_multiplier = -1;
 197:Marigold.cpp  ****         }
 198:Marigold.cpp  ****     } else {
 199:Marigold.cpp  ****         detune_mode = 1;
 200:Marigold.cpp  ****     }
 201:Marigold.cpp  **** 
 202:Marigold.cpp  ****     octave_up_rate_persecond  = std::pow(8.0f, vshimmer) - 1.0f;
 203:Marigold.cpp  ****     octave_up_rate_perinterval = std::min(0.75f, octave_up_rate_persecond / samplerate * interval_s
 204:Marigold.cpp  **** 
 205:Marigold.cpp  ****     float octave_up_rate_persecond2  = std::pow(8.0f, vshimmer_tone) - 1.0f;
 206:Marigold.cpp  ****     float octave_up_rate_perinterval2 = std::min(0.75f, octave_up_rate_persecond2 / samplerate * in
 207:Marigold.cpp  **** 
