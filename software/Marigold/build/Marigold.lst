  30:../../../../Dependencies/libDaisy/src/sys/system.h **** 
  31:../../../../Dependencies/libDaisy/src/sys/system.h ****         /** Method to call on the struct to set to defaults
  32:../../../../Dependencies/libDaisy/src/sys/system.h ****          ** CPU Freq set to 400MHz
  33:../../../../Dependencies/libDaisy/src/sys/system.h ****          ** Cache Enabled
  34:../../../../Dependencies/libDaisy/src/sys/system.h ****          ** */
  35:../../../../Dependencies/libDaisy/src/sys/system.h ****         void Defaults()
  36:../../../../Dependencies/libDaisy/src/sys/system.h ****         {
