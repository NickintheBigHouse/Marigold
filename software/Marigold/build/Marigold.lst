  51:../../../../Dependencies/libDaisy/src/per/adc.h ****         SPEED_387CYCLES_5,
  52:../../../../Dependencies/libDaisy/src/per/adc.h ****         SPEED_810CYCLES_5,
  53:../../../../Dependencies/libDaisy/src/per/adc.h ****     };
