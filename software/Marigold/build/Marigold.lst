  38:../../../../Dependencies/libDaisy/src/per/adc.h ****         MUX_SEL_2,    /**< & */
  39:../../../../Dependencies/libDaisy/src/per/adc.h ****         MUX_SEL_LAST, /**< & */
  40:../../../../Dependencies/libDaisy/src/per/adc.h ****     };
