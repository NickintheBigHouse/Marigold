 218:Marigold.cpp  **** // ============================================================
 219:Marigold.cpp  **** // UpdateButtons
 220:Marigold.cpp  **** // Emerald footswitch mapping:
 221:Marigold.cpp  **** //   D6 (phys 7) = right footswitch = BYPASS toggle
 222:Marigold.cpp  **** //   D5 (phys 6) = left footswitch  = FREEZE (hold)
ARM GAS  C:\Users\Spencer\AppData\Local\Temp\ccWmt4tk.s 			page 25


 223:Marigold.cpp  **** // Both footswitches are active-low on Emerald 125b hardware
 224:Marigold.cpp  **** // (.Pressed() returns false when physically pressed).
 225:Marigold.cpp  **** // We read the GPIO directly here since we're not using DaisyPetal.
 226:Marigold.cpp  **** // ============================================================
 227:Marigold.cpp  **** static void UpdateButtons()
 228:Marigold.cpp  **** {
 229:Marigold.cpp  ****     // Read raw GPIO state from dedicated switch inputs.
 230:Marigold.cpp  ****     // Active-low behavior:
 231:Marigold.cpp  ****     // - .Read() == false means pin is LOW  -> physically pressed
 232:Marigold.cpp  ****     // - .Read() == true  means pin is HIGH -> physically released
 233:Marigold.cpp  ****     // We invert to convert into the more readable boolean "pressed" semantics.
 234:Marigold.cpp  ****     bool fs1_raw = !fs_bypass_pin.Read();  // true when BYPASS switch is physically pressed
 235:Marigold.cpp  ****     bool fs2_raw = !fs_freeze_pin.Read();  // true when FREEZE switch is physically pressed
 236:Marigold.cpp  **** 
 237:Marigold.cpp  ****     // Bypass: toggle on rising edge (press)
 238:Marigold.cpp  ****     if (fs1_raw && !fs1_prev) {
 239:Marigold.cpp  ****         bypass = !bypass;
 240:Marigold.cpp  **** 
 241:Marigold.cpp  ****         // Mute briefly during relay transition to prevent pop
 242:Marigold.cpp  ****         SetMute(true);
 243:Marigold.cpp  ****         System::DelayUs(1000);  // 1ms mute window
 244:Marigold.cpp  ****         SetRelay(bypass);
 245:Marigold.cpp  ****         System::DelayUs(1000);
 246:Marigold.cpp  ****         SetMute(false);
 247:Marigold.cpp  **** 
 248:Marigold.cpp  ****         led1.Set(bypass ? 0.0f : 1.0f);
 249:Marigold.cpp  ****     }
 250:Marigold.cpp  **** 
 251:Marigold.cpp  ****     // Freeze: hold behavior (active while held)
 252:Marigold.cpp  ****     freeze = fs2_raw;
 253:Marigold.cpp  ****     led2.Set(freeze ? 1.0f : 0.0f);
 254:Marigold.cpp  **** 
 255:Marigold.cpp  ****     fs1_prev = fs1_raw;
 256:Marigold.cpp  ****     fs2_prev = fs2_raw;
 257:Marigold.cpp  **** 
 258:Marigold.cpp  ****     led1.Update();
 259:Marigold.cpp  ****     led2.Update();
 260:Marigold.cpp  **** }
 261:Marigold.cpp  **** 
 262:Marigold.cpp  **** // ============================================================
 263:Marigold.cpp  **** // AudioCallback
 264:Marigold.cpp  **** // ============================================================
 265:Marigold.cpp  **** static void AudioCallback(AudioHandle::InputBuffer  in,
 266:Marigold.cpp  ****                           AudioHandle::OutputBuffer out,
 267:Marigold.cpp  ****                           size_t                    size)
 268:Marigold.cpp  **** {
 269:Marigold.cpp  ****     ProcessControls();
 270:Marigold.cpp  ****     UpdateButtons();
 271:Marigold.cpp  **** 
 272:Marigold.cpp  ****     for (size_t i = 0; i < size; i++)
 273:Marigold.cpp  ****     {
 274:Marigold.cpp  ****         // Drift oscillators still processed (harmless at drift_mode==1)
 275:Marigold.cpp  ****         drift_multiplier  = drift_osc.Process();
 276:Marigold.cpp  ****         drift_multiplier2 = drift_osc2.Process();
 277:Marigold.cpp  ****         drift_multiplier3 = drift_osc3.Process();
 278:Marigold.cpp  ****         drift_multiplier4 = drift_osc4.Process();
 279:Marigold.cpp  **** 
ARM GAS  C:\Users\Spencer\AppData\Local\Temp\ccWmt4tk.s 			page 26


 280:Marigold.cpp  ****         if (bypass)
 281:Marigold.cpp  ****         {
 282:Marigold.cpp  ****             out[0][i] = in[0][i];
 283:Marigold.cpp  ****             out[1][i] = in[1][i];
 284:Marigold.cpp  ****         }
 285:Marigold.cpp  ****         else
 286:Marigold.cpp  ****         {
 287:Marigold.cpp  ****             stft->write(in[0][i]);
 288:Marigold.cpp  **** 
 289:Marigold.cpp  ****             float wet = 0.0f;
 290:Marigold.cpp  ****             if (reverb_mode == 0) {
 291:Marigold.cpp  ****                 wet = lowpass.Process(samplerateReducer.Process(stft->read()));
 292:Marigold.cpp  ****             } else if (reverb_mode == 1) {
 293:Marigold.cpp  ****                 wet = stft->read();
 294:Marigold.cpp  ****             } else if (reverb_mode == 2) {
 295:Marigold.cpp  ****                 wet = samplerateReducer.Process(stft->read());
 296:Marigold.cpp  ****             }
 297:Marigold.cpp  **** 
 298:Marigold.cpp  ****             out[0][i] = wet * vmix + in[0][i] * (1.0f - vmix);
 299:Marigold.cpp  ****             out[1][i] = out[0][i];
 300:Marigold.cpp  ****         }
 301:Marigold.cpp  ****     }
 302:Marigold.cpp  **** }
