   8:../../../../Dependencies/libDaisy/src/per/sai.h **** namespace daisy
   9:../../../../Dependencies/libDaisy/src/per/sai.h **** {
  10:../../../../Dependencies/libDaisy/src/per/sai.h **** /** 
  11:../../../../Dependencies/libDaisy/src/per/sai.h ****  * Support for I2S Audio Protocol with different bit-depth, samplerate options
  12:../../../../Dependencies/libDaisy/src/per/sai.h ****  * Allows for master or slave, as well as freedom of selecting direction, 
  13:../../../../Dependencies/libDaisy/src/per/sai.h ****  * and other behavior for each peripheral, and block.
  14:../../../../Dependencies/libDaisy/src/per/sai.h ****  * 
  15:../../../../Dependencies/libDaisy/src/per/sai.h ****  * DMA Transfer commands must use buffers located within non-cached memory or use cache maintenance
  16:../../../../Dependencies/libDaisy/src/per/sai.h ****  * To declare an unitialized global element in the DMA memory section:
  17:../../../../Dependencies/libDaisy/src/per/sai.h ****  *    int32_t DSY_DMA_BUFFER_SECTOR my_buffer[96];
  18:../../../../Dependencies/libDaisy/src/per/sai.h ****  *
  19:../../../../Dependencies/libDaisy/src/per/sai.h ****  * Callback functions will be called once per half of the buffer. In the above example, 
  20:../../../../Dependencies/libDaisy/src/per/sai.h ****  * the callback function would be called once for every 48 samples.
  21:../../../../Dependencies/libDaisy/src/per/sai.h ****  * 
  22:../../../../Dependencies/libDaisy/src/per/sai.h ****  * Use SAI Handle like this:
  23:../../../../Dependencies/libDaisy/src/per/sai.h ****  * 
  24:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  SaiHandle::Config sai_config;
  25:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.periph          = SaiHandle::Config::Peripheral::SAI_1;
  26:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.sr              = SaiHandle::Config::SampleRate::SAI_48KHZ;
  27:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.bit_depth       = SaiHandle::Config::BitDepth::SAI_24BIT;
  28:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.a_sync          = SaiHandle::Config::Sync::MASTER;
  29:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.b_sync          = SaiHandle::Config::Sync::SLAVE;
  30:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.a_dir           = SaiHandle::Config::Direction::RECEIVE;
  31:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.b_dir           = SaiHandle::Config::Direction::TRANSMIT;
  32:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.fs   = {DSY_GPIOE, 4};
  33:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.mclk = {DSY_GPIOE, 2};
  34:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.sck  = {DSY_GPIOE, 5};
  35:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.sa   = {DSY_GPIOE, 6};
  36:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.sb   = {DSY_GPIOE, 3};
  37:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  // Then Initialize
  38:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  SaiHandle sai;
  39:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai.Init(sai_config);
  40:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  // Now you can use it:
  41:../../../../Dependencies/libDaisy/src/per/sai.h ****  *  sai.StartDma(. . .);
  42:../../../../Dependencies/libDaisy/src/per/sai.h ****  */
  43:../../../../Dependencies/libDaisy/src/per/sai.h **** class SaiHandle
  44:../../../../Dependencies/libDaisy/src/per/sai.h **** {
  45:../../../../Dependencies/libDaisy/src/per/sai.h ****   public:
  46:../../../../Dependencies/libDaisy/src/per/sai.h ****     /** Contains settings for initialising an SAI Interface */
  47:../../../../Dependencies/libDaisy/src/per/sai.h ****     struct Config
  48:../../../../Dependencies/libDaisy/src/per/sai.h ****     {
  49:../../../../Dependencies/libDaisy/src/per/sai.h ****         /** Specifies the internal peripheral to use (mapped to different hardware pins) */
  50:../../../../Dependencies/libDaisy/src/per/sai.h ****         enum class Peripheral
  51:../../../../Dependencies/libDaisy/src/per/sai.h ****         {
  52:../../../../Dependencies/libDaisy/src/per/sai.h ****             SAI_1,
  53:../../../../Dependencies/libDaisy/src/per/sai.h ****             SAI_2,
  54:../../../../Dependencies/libDaisy/src/per/sai.h ****         };
  55:../../../../Dependencies/libDaisy/src/per/sai.h **** 
  56:../../../../Dependencies/libDaisy/src/per/sai.h ****         /** Rate at which samples will be streaming to/from the device. */
  57:../../../../Dependencies/libDaisy/src/per/sai.h ****         enum class SampleRate
  58:../../../../Dependencies/libDaisy/src/per/sai.h ****         {
