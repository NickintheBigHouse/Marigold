  32:fourier.h     **** 
  33:fourier.h     **** 		~Fourier()
  34:fourier.h     **** 		{
  35:fourier.h     **** 			delete [] writepoints;
  36:fourier.h     **** 			delete [] readpoints;
  37:fourier.h     **** 			delete [] reading;
  38:fourier.h     **** 			delete [] writing;
  39:fourier.h     **** 		}
  40:fourier.h     **** 
  41:fourier.h     **** 		// writes a single sample (with windowing) into the in array
  42:fourier.h     **** 		void write(T x)
  43:fourier.h     **** 		{
  44:fourier.h     **** 			for (size_t i = 0; i < laps * 2; i++)
  45:fourier.h     **** 			{
  46:fourier.h     **** 				if (writing[i])
  47:fourier.h     **** 				{
  48:fourier.h     **** 					if (writepoints[i] >= 0)
  49:fourier.h     **** 					{
  50:fourier.h     **** 						T amp = (*window)((T)writepoints[i] / N);
  51:fourier.h     **** 						in[writepoints[i] + N * i] = amp * x;
  52:fourier.h     **** 					}
  53:fourier.h     **** 					writepoints[i]++;
  54:fourier.h     **** 
  55:fourier.h     **** 					if (writepoints[i] == N)
  56:fourier.h     **** 					{
  57:fourier.h     **** 						writing[i] = false;
  58:fourier.h     **** 						reading[i] = true;
  59:fourier.h     **** 						readpoints[i] = 0;
  60:fourier.h     **** 
  61:fourier.h     **** 						forward(i); // FTs ith in to ith middle buffer
  62:fourier.h     **** 						process(i); // user-defined; ought to move info from ith middle to out buffer
  63:fourier.h     **** 						backward(i); // IFTs ith out to ith in buffer
  64:fourier.h     **** 
  65:fourier.h     **** 						current = i;
  66:fourier.h     **** 					}
  67:fourier.h     **** 				}
  68:fourier.h     **** 			}
  69:fourier.h     **** 		}
  70:fourier.h     **** 
