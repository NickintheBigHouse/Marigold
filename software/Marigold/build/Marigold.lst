 330              		.file 14 "Marigold.cpp"
   1:Marigold.cpp  **** // Marigold.cpp
   2:Marigold.cpp  **** // Venus Spectral Reverb ported from Marigold (Funbox/DaisyPetal) hardware
   3:Marigold.cpp  **** // to Emerald (custom 125B Daisy Seed) hardware.
   4:Marigold.cpp  **** //
   5:Marigold.cpp  **** // STEP 1: Pin remapping, relay/mute GPIO init, boot into bypass.
   6:Marigold.cpp  **** //         Expression, DIP switches, toggle switches, and MIDI are
   7:Marigold.cpp  **** //         stripped in later steps. They are still present but commented
   8:Marigold.cpp  **** //         out or left inert so the DSP compiles and runs immediately.
   9:Marigold.cpp  **** //
  10:Marigold.cpp  **** // PIN CHANGES vs. original venus.cpp (Marigold hardware):
  11:Marigold.cpp  **** //   Knobs:       ADC_0-5 -> same logical order, physical shift by 1
  12:Marigold.cpp  **** //                (D15=A0 -> now D15=A0, but physical pin 22 not 23)
  13:Marigold.cpp  **** //                Emerald: D15-D20 = physical pins 22-27
  14:Marigold.cpp  **** //   FOOTSWITCH_1 (Bypass): was D25/physical 32 -> now D6/physical 7
  15:Marigold.cpp  **** //   FOOTSWITCH_2 (Freeze): was D26/physical 33 -> now D5/physical 6
  16:Marigold.cpp  **** //   NOTE: Emerald swaps L/R vs Marigold. On Emerald:
  17:Marigold.cpp  **** //         D6 (phys 7) = right footswitch = BYPASS
  18:Marigold.cpp  **** //         D5 (phys 6) = left footswitch  = FREEZE
  19:Marigold.cpp  **** //   LEDs: D22/D23 = physical pins 29/30 (unchanged)
  20:Marigold.cpp  **** //
  21:Marigold.cpp  **** // RELAY / MUTE (Emerald-specific, not present on Marigold):
  22:Marigold.cpp  **** //   DISABLE_AUDIO_BYPASS relay: D1  (physical pin 2)  active-low
  23:Marigold.cpp  **** //   ENABLE_AUDIO_MUTE    mute:  D12 (physical pin 13) active-high
  24:Marigold.cpp  **** //
  25:Marigold.cpp  **** // HARDCODED (hardware not present on Emerald, stripped in Step 3):
  26:Marigold.cpp  **** //   shimmer_mode = 1  (center: octave up only)
  27:Marigold.cpp  **** //   reverb_mode  = 1  (center: normal, no lofi)
  28:Marigold.cpp  **** //   drift_mode   = 1  (center: no drift)
  29:Marigold.cpp  **** 
  30:Marigold.cpp  **** #include <string.h>
  31:Marigold.cpp  **** #include "daisy_seed.h"
  32:Marigold.cpp  **** #include "daisysp.h"
  33:Marigold.cpp  **** 
  34:Marigold.cpp  **** #include <cmath>
  35:Marigold.cpp  **** #include <complex>
  36:Marigold.cpp  **** #include "shy_fft.h"
  37:Marigold.cpp  **** 
  38:Marigold.cpp  **** #include "fourier.h"
  39:Marigold.cpp  **** #include "wave.h"
  40:Marigold.cpp  **** 
  41:Marigold.cpp  **** #define PI 3.1415926535897932384626433832795
  42:Marigold.cpp  **** 
  43:Marigold.cpp  **** using namespace daisy;
  44:Marigold.cpp  **** using namespace daisysp;
  45:Marigold.cpp  **** using namespace soundmath;
  46:Marigold.cpp  **** 
  47:Marigold.cpp  **** // ============================================================
  48:Marigold.cpp  **** // Hardware
  49:Marigold.cpp  **** // ============================================================
  50:Marigold.cpp  **** DaisySeed hw;
  51:Marigold.cpp  **** 
ARM GAS  C:\Users\Spencer\AppData\Local\Temp\ccWmt4tk.s 			page 22


  52:Marigold.cpp  **** // Relay and mute GPIOs (Emerald-specific)
  53:Marigold.cpp  **** // DISABLE_AUDIO_BYPASS: D1, active-low
  54:Marigold.cpp  **** //   Write LOW  -> relay energized -> effect in signal path
  55:Marigold.cpp  **** //   Write HIGH -> relay bypassed  -> dry signal passes
  56:Marigold.cpp  **** // ENABLE_AUDIO_MUTE: D12, active-high
  57:Marigold.cpp  **** //   Write HIGH -> mute on  (use briefly during relay switching)
  58:Marigold.cpp  **** //   Write LOW  -> mute off
  59:Marigold.cpp  **** GPIO relay_pin;   // D1  (physical pin 2)
  60:Marigold.cpp  **** GPIO mute_pin;    // D12 (physical pin 13)
  61:Marigold.cpp  **** 
  62:Marigold.cpp  **** // Helper: set relay to effect path (bypass=false) or bypass path (bypass=true)
  63:Marigold.cpp  **** inline void SetRelay(bool bypass_active) {
  64:Marigold.cpp  ****     // relay is active-low: LOW = effect in path, HIGH = bypass
  65:Marigold.cpp  ****     relay_pin.Write(bypass_active ? true : false);
  66:Marigold.cpp  **** }
  67:Marigold.cpp  **** 
  68:Marigold.cpp  **** // Helper: enable/disable output mute
  69:Marigold.cpp  **** inline void SetMute(bool muted) {
  70:Marigold.cpp  ****     // mute is active-high: HIGH = muted
  71:Marigold.cpp  ****     mute_pin.Write(muted);
  72:Marigold.cpp  **** }
  73:Marigold.cpp  **** 
  74:Marigold.cpp  **** // ============================================================
  75:Marigold.cpp  **** // Parameters
  76:Marigold.cpp  **** // ============================================================
  77:Marigold.cpp  **** Parameter decay, mix, damp, shimmer, shimmer_tone, detune;
  78:Marigold.cpp  **** 
  79:Marigold.cpp  **** float samplerate = 32000.0f;
  80:Marigold.cpp  **** 
  81:Marigold.cpp  **** bool bypass = true;
  82:Marigold.cpp  **** 
  83:Marigold.cpp  **** // Footswitch state (polled directly from GPIO)
  84:Marigold.cpp  **** bool fs1_prev = false;  // D6 = right = bypass
  85:Marigold.cpp  **** bool fs2_prev = false;  // D5 = left  = freeze
  86:Marigold.cpp  **** 
  87:Marigold.cpp  **** // Dedicated GPIO inputs for Emerald footswitches.
  88:Marigold.cpp  **** // NOTE:
  89:Marigold.cpp  **** // - We intentionally use explicit GPIO objects instead of DaisySeed::GetPin(...) so we
  90:Marigold.cpp  **** //   have concrete input instances that support .Init(...) and .Read(...).
  91:Marigold.cpp  **** // - Both switches are active-low on Emerald 125b hardware:
  92:Marigold.cpp  **** //   * Electrical LOW  = physically pressed
  93:Marigold.cpp  **** //   * Electrical HIGH = physically released (via pull-up)
  94:Marigold.cpp  **** GPIO fs_bypass_pin;   // D6 (physical pin 7)  = BYPASS toggle switch
  95:Marigold.cpp  **** GPIO fs_freeze_pin;   // D5 (physical pin 6)  = FREEZE hold switch
  96:Marigold.cpp  **** 
  97:Marigold.cpp  **** // LED pins (D22, D23)
  98:Marigold.cpp  **** Led led1, led2;
  99:Marigold.cpp  **** 
 100:Marigold.cpp  **** // ============================================================
 101:Marigold.cpp  **** // DSP state (unchanged from venus.cpp)
 102:Marigold.cpp  **** // ============================================================
 103:Marigold.cpp  **** SampleRateReducer samplerateReducer;
 104:Marigold.cpp  **** Tone lowpass;
 105:Marigold.cpp  **** int reverb_mode = 1;   // HARDCODED: center = normal
 106:Marigold.cpp  **** 
 107:Marigold.cpp  **** Wave<float> hann([] (float phase) -> float { return 0.5 * (1 - cos(2 * PI * phase)); });
 108:Marigold.cpp  **** Wave<float> halfhann([] (float phase) -> float { return sin(PI * phase); });
ARM GAS  C:\Users\Spencer\AppData\Local\Temp\ccWmt4tk.s 			page 23


 109:Marigold.cpp  **** 
 110:Marigold.cpp  **** const size_t order = 12;
 111:Marigold.cpp  **** const size_t N = (1 << order);
 112:Marigold.cpp  **** const float  sqrtN = sqrt(N);
 113:Marigold.cpp  **** const size_t laps = 4;
 114:Marigold.cpp  **** const size_t buffsize = 2 * laps * N;
 115:Marigold.cpp  **** 
 116:Marigold.cpp  **** float in_buf[buffsize];
 117:Marigold.cpp  **** float middle[buffsize];
 118:Marigold.cpp  **** float out_buf[buffsize];
 119:Marigold.cpp  **** 
 120:Marigold.cpp  **** float reverb_energy[N/2];
 121:Marigold.cpp  **** 
 122:Marigold.cpp  **** ShyFFT<float, N, RotationPhasor>* fft;
 123:Marigold.cpp  **** Fourier<float, N>* stft;
 124:Marigold.cpp  **** 
 125:Marigold.cpp  **** float fft_size = N / 2;
 126:Marigold.cpp  **** 
 127:Marigold.cpp  **** float vdecay, vmix, vdamp, vshimmer, vshimmer_tone, vdetune;
 128:Marigold.cpp  **** float octave_up_rate_persecond, octave_up_rate_perinterval, shimmer_double, shimmer_triple, shimmer
 129:Marigold.cpp  **** float detune_rate_persecond, detune_rate_perinterval, detune_double, detune_remainder;
 130:Marigold.cpp  **** 
 131:Marigold.cpp  **** float window_samples   = 32768.0f;
 132:Marigold.cpp  **** float interval_samples = ceil(window_samples / laps);
 133:Marigold.cpp  **** 
 134:Marigold.cpp  **** bool freeze       = false;
 135:Marigold.cpp  **** int  shimmer_mode = 1;   // HARDCODED: center = octave up
 136:Marigold.cpp  **** int  detune_mode  = 1;
 137:Marigold.cpp  **** int  detune_multiplier = 1;
 138:Marigold.cpp  **** 
 139:Marigold.cpp  **** bool first_start = true;
 140:Marigold.cpp  **** 
 141:Marigold.cpp  **** int  drift_mode = 1;     // HARDCODED: center = no drift
 142:Marigold.cpp  **** Oscillator drift_osc, drift_osc2, drift_osc3, drift_osc4;
 143:Marigold.cpp  **** float drift_multiplier  = 1.0f;
 144:Marigold.cpp  **** float drift_multiplier2 = 1.0f;
 145:Marigold.cpp  **** float drift_multiplier3 = 1.0f;
 146:Marigold.cpp  **** float drift_multiplier4 = 1.0f;
 147:Marigold.cpp  **** 
 148:Marigold.cpp  **** // ============================================================
 149:Marigold.cpp  **** // Knob values array (kept for future MIDI, currently direct)
 150:Marigold.cpp  **** // ============================================================
 151:Marigold.cpp  **** float knobValues[6];
 152:Marigold.cpp  **** 
 153:Marigold.cpp  **** // Analog controls backing each parameter.
 154:Marigold.cpp  **** // IMPORTANT:
 155:Marigold.cpp  **** // - `daisy::Parameter::Init(...)` takes an AnalogControl object, not a raw ADC pointer.
 156:Marigold.cpp  **** // - Each AnalogControl is initialized from the ADC pointer + callback rate first.
 157:Marigold.cpp  **** // - Parameter then reads/scales that control each callback in ProcessControls().
 158:Marigold.cpp  **** AnalogControl knob_ctrl_decay;
 159:Marigold.cpp  **** AnalogControl knob_ctrl_mix;
 160:Marigold.cpp  **** AnalogControl knob_ctrl_damp;
 161:Marigold.cpp  **** AnalogControl knob_ctrl_shimmer;
 162:Marigold.cpp  **** AnalogControl knob_ctrl_shimmer_tone;
 163:Marigold.cpp  **** AnalogControl knob_ctrl_detune;
 164:Marigold.cpp  **** 
 165:Marigold.cpp  **** // ============================================================
ARM GAS  C:\Users\Spencer\AppData\Local\Temp\ccWmt4tk.s 			page 24


 166:Marigold.cpp  **** // ProcessControls
 167:Marigold.cpp  **** // ============================================================
 168:Marigold.cpp  **** static void ProcessControls()
 169:Marigold.cpp  **** {
 170:Marigold.cpp  ****     // Read knobs directly (no expression remapping in Step 1)
 171:Marigold.cpp  ****     vdecay        = decay.Process()        * 99.0f + 1.0f;
 172:Marigold.cpp  ****     vmix          = mix.Process();
 173:Marigold.cpp  ****     vdamp         = damp.Process();
 174:Marigold.cpp  ****     vshimmer      = shimmer.Process();
 175:Marigold.cpp  ****     vshimmer_tone = shimmer_tone.Process();
 176:Marigold.cpp  ****     float vdetune_temp = detune.Process();
 177:Marigold.cpp  **** 
 178:Marigold.cpp  ****     vdetune = fabsf(vdetune_temp);
 179:Marigold.cpp  **** 
 180:Marigold.cpp  ****     // Drift automation: drift_mode == 1 (no drift), so this block is inert
 181:Marigold.cpp  ****     // but kept structurally intact for Step 3 cleanup.
 182:Marigold.cpp  ****     if (drift_mode == 0 || drift_mode == 2) {
 183:Marigold.cpp  ****         vdamp         = vdamp         * fabsf(drift_multiplier)  * 0.7f + 0.3f;
 184:Marigold.cpp  ****         vshimmer     *= fabsf(drift_multiplier2);
 185:Marigold.cpp  ****         vshimmer_tone *= fabsf(drift_multiplier3);
 186:Marigold.cpp  ****         vdetune      *= fabsf(drift_multiplier4);
 187:Marigold.cpp  ****     }
 188:Marigold.cpp  **** 
 189:Marigold.cpp  ****     if (vdetune > 0.03f) {
